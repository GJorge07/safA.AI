generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cliente {
  id        String     @id @default(cuid())
  nome      String
  contratos Contrato[]
  createdAt DateTime   @default(now())
}

model Contrato {
  id               String    @id @default(cuid())
  cliente          Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId        String

  tipoPagamento    TipoPagamento
  valorTotal       Decimal   @db.Decimal(14, 2)

  clausulaOriginal String

  parcelas         Parcela[]

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([clienteId])
}

model Parcela {
  id         String     @id @default(cuid())

  contrato   Contrato   @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  contratoId String

  valor      Decimal    @db.Decimal(14, 2)
  vencimento DateTime

  pagamento  Pagamento?

  createdAt  DateTime   @default(now())

  @@index([contratoId])
  @@index([vencimento])
}

model Pagamento {
  id         String   @id @default(cuid())

  parcela    Parcela  @relation(fields: [parcelaId], references: [id], onDelete: Cascade)
  parcelaId  String   @unique

  valorPago  Decimal  @db.Decimal(14, 2)
  dataPago   DateTime @default(now())

  createdAt  DateTime @default(now())
}

enum TipoPagamento {
  FIXO
  EXITO
  MISTO
}

// Conexão única com o Google Drive (ferramenta de uso único, sem sistema de
// login) — sempre uma única linha, identificada por id fixo "default".
model DriveConexao {
  id           String   @id
  refreshToken String
  contaEmail   String?
  pastaId      String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

// Evita reprocessar o mesmo arquivo do Drive a cada sincronização.
model DriveArquivoImportado {
  id          String   @id @default(cuid())
  driveFileId String   @unique
  status      String
  contratoId  String?
  importadoEm DateTime @default(now())
}