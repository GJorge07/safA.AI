{
  "name": "safa-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:api && npm run test:ai",
    "test:api": "node --import ./tests/register.mjs --test tests/*.test.mjs",
    "test:ai": "node --import tsx --test lib/ai/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "eval:extraction": "node --import tsx lib/ai/run-evals.ts"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@prisma/client": "^6.19.3",
    "@google/genai": "^2.3.0",
    "mammoth": "^1.10.0",
    "pdf-parse": "^2.4.5",
    "zod": "^4.0.0",
    "recharts": "3.10.1",
    "lucide-react": "1.45.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0",
    "date-fns": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "tsx": "^4.20.0"
  }
}
